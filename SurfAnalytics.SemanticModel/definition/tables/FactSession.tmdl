table FactSession
	lineageTag: 496fb908-1474-4635-a63f-5d0f24e57a7e

	measure 'Total Sessions' = COUNTROWS(FactSession)
		formatString: #,0
		displayFolder: Sessions
		lineageTag: c78811c1-aee9-4f9c-9484-70e9b0a8d177

	measure 'Waves Caught' = SUM(FactSession[WavesCaught])
		formatString: #,0
		displayFolder: Sessions
		lineageTag: f837ac76-8b90-4ac5-afa9-5f6880500132

	measure 'Hours in Water' = DIVIDE(SUM(FactSession[DurationMin]), 60)
		formatString: #,0
		displayFolder: Sessions
		lineageTag: 6d35db2b-2e9a-4d0e-bcb9-64e07d76a94e

	measure 'Avg Waves per Session' = DIVIDE([Waves Caught], [Total Sessions])
		formatString: 0.0
		displayFolder: Sessions
		lineageTag: b2f8e461-a113-4988-83ea-6ce9f6d63914

	measure 'Avg Wave Height (ft)' = AVERAGE(FactSession[WaveHeightFt])
		formatString: 0.0
		displayFolder: Conditions
		lineageTag: a9771648-ef19-4c82-a013-341a599796d4

	measure 'Avg Session Rating' = AVERAGE(FactSession[SessionRating])
		formatString: 0.00
		displayFolder: Conditions
		lineageTag: d460a79e-0420-4c5f-8894-1f73689a9529

	measure 'Longest Ride (s)' = MAX(FactSession[LongestRideSec])
		formatString: 0.0
		displayFolder: Conditions
		lineageTag: 5eb826e5-4d80-40bf-81c8-877bd99cf67e

	measure 'Avg Water Temp (C)' = AVERAGE(FactSession[WaterTempC])
		formatString: 0.0
		displayFolder: Conditions
		lineageTag: f764ccd9-572a-4ce6-9376-52062d7fa6fa

	measure 'Active Surfers' = DISTINCTCOUNT(FactSession[SurferKey])
		formatString: #,0
		displayFolder: Sessions
		lineageTag: d30fafa9-142f-4704-9dac-f65b161a10d1

	column SessionID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: acb6a0d4-7b66-4365-bf9d-a2c1c302b453
		summarizeBy: none
		sourceColumn: SessionID

		annotation SummarizationSetBy = Automatic

	column DateKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 08a6c1d2-6f00-4c19-9f50-d89befe8f150
		summarizeBy: none
		sourceColumn: DateKey

		annotation SummarizationSetBy = Automatic

	column SpotKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 210aaba8-5b20-4b15-ad4c-97936752c858
		summarizeBy: none
		sourceColumn: SpotKey

		annotation SummarizationSetBy = Automatic

	column SurferKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f10020ac-dd06-4881-9dc5-9efcede2b081
		summarizeBy: none
		sourceColumn: SurferKey

		annotation SummarizationSetBy = Automatic

	column BoardKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 3fb122b6-33d8-4aa7-b4b5-5c0a5cb1db3b
		summarizeBy: none
		sourceColumn: BoardKey

		annotation SummarizationSetBy = Automatic

	column DurationMin
		dataType: int64
		formatString: #,0
		lineageTag: c12013be-17bd-4499-a9db-d10de8512820
		summarizeBy: sum
		sourceColumn: DurationMin

		annotation SummarizationSetBy = Automatic

	column WavesCaught
		dataType: int64
		formatString: #,0
		lineageTag: c50df389-78a1-47a4-9846-a25162c868a4
		summarizeBy: sum
		sourceColumn: WavesCaught

		annotation SummarizationSetBy = Automatic

	column WaveHeightFt
		dataType: double
		formatString: 0.0
		lineageTag: cdc0b625-9e43-495c-8324-3778e30c2c22
		summarizeBy: average
		sourceColumn: WaveHeightFt

		annotation SummarizationSetBy = Automatic

	column LongestRideSec
		dataType: double
		formatString: 0.0
		lineageTag: eb31c07f-0f55-4905-b584-9d590bc01631
		summarizeBy: max
		sourceColumn: LongestRideSec

		annotation SummarizationSetBy = Automatic

	column WindKph
		dataType: double
		formatString: 0.0
		lineageTag: 47fc25d8-4880-4606-b5a8-88b0d6845b3b
		summarizeBy: average
		sourceColumn: WindKph

		annotation SummarizationSetBy = Automatic

	column WaterTempC
		dataType: double
		formatString: 0.0
		lineageTag: b52742c3-7469-488b-a300-94c839fb7781
		summarizeBy: average
		sourceColumn: WaterTempC

		annotation SummarizationSetBy = Automatic

	column SessionRating
		dataType: int64
		formatString: 0
		lineageTag: 8b3e2175-345d-4e82-950f-504d7d7fd246
		summarizeBy: average
		sourceColumn: SessionRating

		annotation SummarizationSetBy = Automatic

	partition FactSession = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "FactSession.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"SessionID", Int64.Type}, {"DateKey", Int64.Type}, {"SpotKey", Int64.Type}, {"SurferKey", Int64.Type}, {"BoardKey", Int64.Type}, {"DurationMin", Int64.Type}, {"WavesCaught", Int64.Type}, {"WaveHeightFt", type number}, {"LongestRideSec", type number}, {"WindKph", type number}, {"WaterTempC", type number}, {"SessionRating", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

