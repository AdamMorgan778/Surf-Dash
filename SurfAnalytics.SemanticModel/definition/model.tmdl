model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "DimDate", "DimSpot", "DimSurfer", "DimBoard", "DimProduct", "FactSession", "FactSales"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table DimDate
ref table DimSpot
ref table DimSurfer
ref table DimBoard
ref table DimProduct
ref table FactSession
ref table FactSales

